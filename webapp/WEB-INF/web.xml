<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>OnlineQuizApplication</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet Declarations and Mappings -->
    <servlet>
        <servlet-name>AddQuestionServlet</servlet-name>
        <servlet-class>com.quiz.servlet.AddQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddQuestionServlet</servlet-name>
        <url-pattern>/addQuestion</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PublishQuizServlet</servlet-name>
        <servlet-class>com.quiz.servlet.PublishQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublishQuizServlet</servlet-name>
        <url-pattern>/publishQuiz</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteQuestionServlet</servlet-name>
        <servlet-class>com.quiz.servlet.DeleteQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteQuestionServlet</servlet-name>
        <url-pattern>/deleteQuestion</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>JoinQuizServlet</servlet-name>
        <servlet-class>com.quiz.servlet.JoinQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JoinQuizServlet</servlet-name>
        <url-pattern>/joinQuiz</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QuizServlet</servlet-name>
        <servlet-class>com.quiz.servlet.QuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QuizServlet</servlet-name>
        <url-pattern>/quiz</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResultServlet</servlet-name>
        <servlet-class>com.quiz.servlet.ResultServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResultServlet</servlet-name>
        <url-pattern>/submitQuiz</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout Configuration (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
